+/* On Android the overflow probe can miss (fonts measure differently inside the WebView), so the end fade and
+   a reserved strip for the close button apply to every tab, not only the ones that reported an overflow. Short
+   titles end long before the fade region, so the only visible change is that a long title can never run under
+   the close button again. */
+[data-titlebar-tab]:not([data-editing="true"]) [data-slot="tab-link"] {
+  --tab-title-fade-offset: 24px;
+  padding-inline-end: 16px;
+  -webkit-mask-image: linear-gradient(
+    to right,
+    black 0,
+    black calc(100% - var(--tab-title-fade-offset) - 16px),
+    transparent calc(100% - var(--tab-title-fade-offset)),
+    transparent 100%
+  );
+  mask-image: linear-gradient(
+    to right,
+    black 0,
+    black calc(100% - var(--tab-title-fade-offset) - 16px),
+    transparent calc(100% - var(--tab-title-fade-offset)),
+    transparent 100%
+  );
+}
