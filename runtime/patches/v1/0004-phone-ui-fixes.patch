+/* OpenCode for Android: below the md breakpoint the side panels are desktop luxuries the chat cannot share its
+   width with. The file tree (the session's file list with its "All files" tab) opens as an overlay on the right
+   instead of squeezing the conversation, so the phone gets the same file browser without a redesign. */
+@media (max-width: 767px) {
+  #file-tree-panel {
+    position: absolute !important;
+    inset-block: 0 !important;
+    inset-inline-end: 0 !important;
+    width: min(85%, 340px) !important;
+    z-index: 30;
+    box-shadow: var(--shadow-lg-border-base);
+    background: var(--surface-raised-stronger-non-alpha);
+  }
+}
